# Optional API keys for broader collection.
# Public RSS and Google News RSS work without these.

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

X_BEARER_TOKEN=

# Google Gemini API hosted Gemma.
# Do not commit real tokens.
HF_TOKEN=
CHIP_BRIEFING_LLM_API_KEY=
CHIP_BRIEFING_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CHIP_BRIEFING_LLM_MODEL=gemma-4-31b-it
CHIP_BRIEFING_LLM_MAX_ITEMS=100
CHIP_BRIEFING_LLM_TIMEOUT=45

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SEND_RUN_LOG=1
TELEGRAM_TIMEOUT=20

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=script:chip-briefing:v2.0 (by /u/your_reddit_username)
REDDIT_DATA_API_APPROVED=false
CHIP_BRIEFING_COMMUNITY_USER_AGENT=script:chip-briefing:v2.1 (contact: github.com/wlsalswo14)

# Optional tuning
CHIP_BRIEFING_MAX_ITEMS=36
CHIP_BRIEFING_DAILY_SUMMARY_MAX_ITEMS=10
CHIP_BRIEFING_TIMEOUT=15
